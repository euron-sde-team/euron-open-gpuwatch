    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.14.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "recharts": "^3.2.1",
    "sonner": "^2.0.7",
