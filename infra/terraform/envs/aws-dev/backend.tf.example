# Copy to backend.tf to keep state in S3 (recommended for anything shared).
# State contains generated secrets (the database password, the cache AUTH token, the
# signing secrets): the bucket must be private, versioned and encrypted, and access
# limited to the people who deploy.
#
# terraform {
#   backend "s3" {
#     bucket       = "<your-terraform-state-bucket>"
#     key          = "euron-open-gpuwatch/aws-dev.tfstate"
#     region       = "<region>"
#     encrypt      = true
#     use_lockfile = true   # S3-native state locking (no DynamoDB table needed)
#   }
# }
