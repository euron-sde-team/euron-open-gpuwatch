# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
SESSION_SECRET=replace-with-output-of-make-env
API_KEY_PEPPER=replace-with-output-of-make-env
LOCAL_MASTER_KEY=replace-with-output-of-make-env
GW_DEMO_PASSWORD=replace-with-output-of-make-env

# Optional overrides
# GW_LOG_LEVEL=INFO
# GW_REDIS_URL=               (empty: run the whole stack without Redis)
# GW_DEMO_DAYS=30             (history the simulated demo hosts backfill)
# GW_WEB_PORT=4410
# GW_API_PORT=4430
# GW_MAILPIT_PORT=4425
# GW_MOCK_VLLM_PORT=4450
# GW_PG_PORT=4442
# GW_REDIS_PORT=4479
# GW_FLOCI_PORT=4466
